# =============================================================================
# Digital PEWS SMART sandbox - environment configuration
# =============================================================================
# Copy this file to .env and adjust as needed. The .env file is read by
# `s/up smart` and `s/down smart` via `docker compose --env-file`.
#
# This is an R4-only sandbox. R2/R3 servers from the upstream smart-dev-sandbox
# are not included.

# Host Machine
# The host that the sandbox runs on. Use "localhost" for local dev, or your
# LAN IP to share with other machines on the network.
HOST=localhost

# HAPI R4 FHIR Server
# 1 to enable, 0 to disable
R4_ENABLED=1
# Server port (mapped to container port 8080)
R4_PORT=4004
# Resource limits
R4_MEMORY=2g
R4_CPU_CORES=2
# HAPI image. Use r4-empty for a clean database (we seed our own data).
# To use pre-seeded Synthea data instead, change to: smartonfhir/hapi-5:r4-synthea
# WARNING: If you change the image, you must delete the r4-database volume:
#   docker container rm hapi-r4 && docker volume rm digital-pews_r4-database
R4_IMAGE=smartonfhir/hapi-5:r4-empty

# Seed
# 1 to run the seed container on boot, 0 to skip (useful after the first run
# since the data persists in the r4-database volume)
SEED_ENABLED=1
# Which seed file to use:
#   pews.json           - Alex Thompson only (hand-authored, single patient)
#   generated-pews.json - all 5 demo scenarios (generated from demo-data.js)
SEED_FILE=generated-pews.json

# FHIR Viewer
FHIR_VIEWER_ENABLED=1
FHIR_VIEWER_PORT=4011

# Patient Browser
PATIENT_BROWSER_ENABLED=1
PATIENT_BROWSER_PORT=4012

# SMART Launcher
LAUNCHER_ENABLED=1
LAUNCHER_PORT=4013

# Control Panel
CONTROL_PANEL_ENABLED=1
CONTROL_PANEL_PORT=4000